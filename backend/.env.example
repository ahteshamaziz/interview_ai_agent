DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/interview_ai

# Speech segmentation / "pause splits one question" tuning:
# - DG_ENDPOINTING_MS: Deepgram endpointing sensitivity (ms). Higher = fewer splits on short pauses.
# - UTTERANCE_SILENCE_MS: How long of silence after Deepgram speech_final before we answer (ms).
# - MIN_UTTERANCE_CHARS: Ignore ultra-short fragments that tend to be noise.
DG_ENDPOINTING_MS=600
UTTERANCE_SILENCE_MS=600
MIN_UTTERANCE_CHARS=12
