DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/interview_ai

# Speech segmentation / "pause splits one question" tuning:
# - DG_ENDPOINTING_MS: Deepgram silence before a segment is finalized (ms). Higher = fewer splits.
# - UTTERANCE_SILENCE_MS: Short debounce after a complete-looking turn + speech_final (ms).
# - UTTERANCE_MAX_PAUSE_MS: Long debounce through mid-question thinking pauses (ms).
# - MIN_UTTERANCE_CHARS: Ignore ultra-short fragments that tend to be noise.
DG_ENDPOINTING_MS=1500
UTTERANCE_SILENCE_MS=1800
UTTERANCE_MAX_PAUSE_MS=4500
MIN_UTTERANCE_CHARS=12

# Speed / model tuning:
# - EXTRACT_MODEL / ANSWER_MODEL: use Haiku for low latency (default).
#   Set ANSWER_MODEL=claude-sonnet-4-6 only if you want higher quality and can wait.
# - ANSWER_MAX_TOKENS: lower = faster finishes
EXTRACT_MODEL=claude-haiku-4-5-20251001
ANSWER_MODEL=claude-haiku-4-5-20251001
ANSWER_MAX_TOKENS=1200
SEMANTIC_THRESHOLD=0.72

# Conversation memory for follow-ups ("give an example", "why?", etc.):
# - MAX_HISTORY_TURNS: prior Q/A pairs kept and sent to the model
# - HISTORY_ANSWER_CHARS: truncate stored answers to keep prompts small
MAX_HISTORY_TURNS=5
HISTORY_ANSWER_CHARS=900
